# ─── Better Auth ────────────────────────────────────────────────────────────
# Secret zum Signieren von Sessions. Generieren mit: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Basis-URL der App (Server). Lokal http://localhost:3000, in Prod die Domain.
BETTER_AUTH_URL=http://localhost:3000
# Gleiche URL, aber im Client verfuegbar (NEXT_PUBLIC_*).
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ─── Turso / libSQL ─────────────────────────────────────────────────────────
# Aus dem Turso-Dashboard: `turso db show <db>` und `turso db tokens create <db>`.
DATABASE_URL=libsql://<deine-db>.turso.io
DATABASE_AUTH_TOKEN=

# ─── Google OAuth (optional) ────────────────────────────────────────────────
# Aus der Google Cloud Console. Redirect-URI:
#   http://localhost:3000/api/auth/callback/google  (lokal)
#   https://<domain>/api/auth/callback/google        (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Seed: Admin anlegen (npm run db:seed) ──────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# ─── Admin-Passwort setzen (npm run db:set-password) ─────────────────────────
# Nur lokal/einmalig fuer das Script benoetigt, NICHT in Prod setzen.
SET_ADMIN_EMAIL=
SET_ADMIN_PASSWORD=
SET_ADMIN_NAME=

# ─── Social ─────────────────────────────────────────────────────────────────
# Instagram-Profil der Schule (im Client verfuegbar, daher NEXT_PUBLIC_*).
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/paritariasalviati/
